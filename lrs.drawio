        <mxCell id="info_card_1" value="&lt;div style=&quot;font-size:13px; font-weight:bold; color:#1e293b; border-bottom:2px solid #e2e8f0; padding-bottom:6px; margin-bottom:8px;&quot;&gt;&lt;b&gt;KARAKTERISTIK LRS &amp;amp; ATURAN TRANSFORMASI ERD&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:0; padding-left:16px; font-size:11px; color:#334155; line-height:1.6;&quot;&gt;&lt;li&gt;&lt;b&gt;Transformasi Relasi 1 : N:&lt;/b&gt; Primary Key dari tabel sisi &quot;One&quot; diteruskan sebagai Foreign Key pada tabel sisi &quot;Many&quot; (contoh: &lt;code&gt;categories.id&lt;/code&gt; &amp;rarr; &lt;code&gt;menus.category_id&lt;/code&gt;).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Transformasi Relasi M : N:&lt;/b&gt; Dipecah menjadi tabel perantara / junction dengan relasi 1 : N, yaitu:&lt;br&gt;&amp;bull; &lt;b&gt;menu_recipes&lt;/b&gt; (menghubungkan &lt;code&gt;menus&lt;/code&gt; dan &lt;code&gt;ingredients&lt;/code&gt;)&lt;br&gt;&amp;bull; &lt;b&gt;order_items&lt;/b&gt; (menghubungkan &lt;code&gt;orders&lt;/code&gt; dan &lt;code&gt;menus&lt;/code&gt;)&lt;br&gt;&amp;bull; &lt;b&gt;procurement_items&lt;/b&gt; (menghubungkan &lt;code&gt;procurements&lt;/code&gt; dan &lt;code&gt;ingredients&lt;/code&gt;)&lt;br&gt;&amp;bull; &lt;b&gt;stock_transfer_items&lt;/b&gt; (menghubungkan &lt;code&gt;stock_transfers&lt;/code&gt; dan &lt;code&gt;ingredients&lt;/code&gt;).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Tingkat Normalisasi (3NF):&lt;/b&gt; Seluruh tabel bebas redundansi anomali parsial (2NF) dan anomali transitif (3NF), memastikan konsistensi saldo stok &amp;amp; riwayat transaksi.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;shadow=1;align=left;spacing=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1100" y="840" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="info_card_2" value="&lt;div style=&quot;font-size:13px; font-weight:bold; color:#1e293b; border-bottom:2px solid #e2e8f0; padding-bottom:6px; margin-bottom:8px;&quot;&gt;&lt;b&gt;RINGKASAN MODUL &amp;amp; MULTI-ROLE SYSTEM&lt;/b&gt;&lt;/div&gt;&lt;table style=&quot;width:100%; font-size:11px; color:#334155; border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 0; font-weight:bold; width:110px;&quot;&gt;POS &amp;amp; Kasir:&lt;/td&gt;&lt;td&gt;Pesanan Dine-in (Meja/QR) &amp;amp; Takeaway, Payment Cash/Midtrans QRIS, Kembalian Tunai.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 0; font-weight:bold;&quot;&gt;Dapur (Kitchen):&lt;/td&gt;&lt;td&gt;Antrean FIFO otomatis, pengurangan stok toko berdasarkan BOM (&lt;i&gt;menu_recipes&lt;/i&gt;).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 0; font-weight:bold;&quot;&gt;Gudang &amp;amp; Toko:&lt;/td&gt;&lt;td&gt;Transfer stok antar lokasi (Surat Jalan), pencatatan audit &lt;i&gt;stock_mutations&lt;/i&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 0; font-weight:bold;&quot;&gt;Pengadaan:&lt;/td&gt;&lt;td&gt;Purchase Order bahan baku ke supplier dengan persetujuan/approval berjenjang oleh Owner.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 0; font-weight:bold;&quot;&gt;Notifikasi:&lt;/td&gt;&lt;td&gt;Alert real-time untuk order baru dapur, pesanan siap saji kasir, dan reorder batas minimum stok.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;shadow=1;align=left;spacing=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1680" y="840" width="730" height="230" as="geometry" />
        </mxCell>
